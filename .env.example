# Copy to .env — never commit real secrets.

NODE_ENV=development
APP_ENV=local

# --- Postgres (docker compose) ---
POSTGRES_USER=janus
POSTGRES_PASSWORD=janus
POSTGRES_DB=janus
POSTGRES_PORT=5432
DATABASE_URL=postgresql://janus:janus@localhost:5432/janus?schema=public

# --- Redis ---
# Local: redis://localhost:6379/0 (compose may use redis://:janus@localhost:6379/0)
# ECS: set REDIS_HOST (or REDIS_URL). REDIS_URL is required in production.
REDIS_URL=redis://:janus@localhost:6379/0

# --- LocalStack (S3 + SQS) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_UPLOADS_BUCKET=janus-uploads
S3_PUBLIC_MEDIA_BUCKET=janus-public-media
S3_VAULT_BUCKET=janus-vault
SQS_MEDIA_TRANSCODE_URL=http://localhost:4566/000000000000/media-transcode
SQS_MEDIA_CALLBACKS_URL=http://localhost:4566/000000000000/media-callbacks
SQS_NDA_LIFECYCLE_URL=http://localhost:4566/000000000000/nda-lifecycle
SQS_NOTIFY_SEND_URL=http://localhost:4566/000000000000/notify-send

# --- API ---
PORT=3000
AUTH_MODE=local
LOCAL_JWT_SECRET=janus-local-dev-only-change-me
MEDIA_DRIVER=s3
TRANSCODE_DRIVER=mock
MODERATION_DRIVER=noop
WORKERS_ENABLED=true
MEDIA_PUBLIC_BASE=http://localhost:4566/janus-public-media
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:3001

# --- Cognito (required when AUTH_MODE=cognito) ---
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# --- Workers / notifications / media (round 3) ---
# inline: run queue handlers in-process (default with LocalStack). sqs: publish to SQS and run
#   `pnpm --filter @janus/api worker` (or start:worker) to consume all queues.
QUEUE_MODE=
TRANSCODE_DRIVER=ffmpeg          # ffmpeg (required in prod) | mock (tests only)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MODERATION_DRIVER=noop           # noop | manual (admin approval queue) | rekognition
PUSH_DRIVER=log                  # log | expo
EXPO_ACCESS_TOKEN=
NDA_SWEEP_INTERVAL_SEC=300
SESSION_TOKEN_TTL=24h
AVATAR_COPY_ALLOWED_HOSTS=googleusercontent.com,graph.facebook.com,fbcdn.net
