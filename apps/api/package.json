{
  "name": "@janus/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "rm -rf dist",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "worker": "nest start --entryFile workers/main",
    "start:worker": "node dist/workers/main.js",
    "start:migrate": "prisma migrate deploy --schema ./prisma/schema.prisma && node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand --forceExit",
    "openapi": "jest --runInBand --forceExit -t \"exports OpenAPI\"",
    "migrate:deploy": "prisma migrate deploy --schema ./prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.758.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/client-sqs": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@fastify/compress": "^7.0.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^7.0.4",
    "@janus/api-types": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.16.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.11.0",
    "fastify": "4.28.1",
    "ioredis": "^5.6.0",
    "jose": "^5.9.6",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
