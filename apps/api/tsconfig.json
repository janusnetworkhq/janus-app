{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noEmit": false,
    "sourceMap": true,
    "incremental": true,
    // Keep build info inside outDir so Nest `deleteOutDir` cannot leave a
    // stale cache that skips emit and then fails with MODULE_NOT_FOUND.
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "exactOptionalPropertyTypes": false,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "scripts"]
}
